# Copy this file to .env.local and fill in real values. Never commit .env.local.

# From your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The shared PIN staff enter to unlock /serve and /admin/*. Pick any digits.
STAFF_PIN=1234

# A random secret used to sign the staff login cookie. Generate one with:
#   openssl rand -hex 32
STAFF_SESSION_SECRET=replace-with-a-long-random-string
